# This is the MODULE.bazel file for the monorepo.
# It declares the module itself and its dependencies on other Bazel modules.

# Define the name and version of your module.
# Replace 'your_org_monorepo' and '1.0.0' with appropriate values.
module(
    name = "uzero_org",
    version = "1.0.0",
    # You can add compatibility level if needed for future versions
    # compatibility_level = 1,
)

# --- Declare Dependencies on External Bazel Modules ---
# Use bazel_dep to declare dependencies on rulesets and other modules.
# You'll need to find the correct module names and versions for the rules
# you need for F#, TypeScript, and Python.

# bazel_dep(name = "rules_python", version = "1.4.0-rc4")

# Example: Dependency on rules_js (commonly used for TypeScript/JavaScript)
# Replace '1.0.0' with the desired version of rules_js.
# bazel_dep(name = "aspect_rules_ts", version = "3.5.3")

bazel_dep(name = "rules_dotnet", version = "0.18.2")

# --- Register Toolchains ---
# Toolchains are needed to tell Bazel how to build code for specific languages
# and platforms. You typically register toolchains provided by the rulesets
# you declared dependencies on.

# Example: Register Python toolchains
# This loads the toolchain registration function from rules_python.
# python = use_extension("@rules_python//python/extensions:python.bzl", "python")
# python.toolchain(
#     python_version = "3.13",
# )

# pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
# pip.parse(
#     hub_name = "pypi",
#     python_version = "3.13",
#     requirements_lock = "//:requirements_lock.txt",
# )
#
# use_repo(pip, "pypi")
#
# rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
# rules_ts_ext.deps(ts_version_from = "//:package.json")
# use_repo(rules_ts_ext, "npm_typescript")
#

# This loads the toolchain registration function from rules_dotnet.
dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "9.0.101")
use_repo(dotnet, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

paket2bazel_dependencies_extension = use_extension(
    "@rules_dotnet//dotnet:paket.paket2bazel_dependencies_extension.bzl",
    "paket2bazel_dependencies_extension")
use_repo(paket2bazel_dependencies_extension, "paket.paket2bazel_dependencies")

paket_ext = use_extension("//:paket.main_extension.bzl", "main_extension")
use_repo(paket_ext, "paket.main")

